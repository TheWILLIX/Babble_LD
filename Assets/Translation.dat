N","FR"],"values":["To go even higher in the geysers!","Pour aller encore plus haut dans les geysers !"]}},{"Category":"Main Menu","Lines":{"keys":["EN","FR"],"values":["Quit","Quitter"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["gave you 1","t'as donné 1"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["Item received!","Objet reçu !"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["Recipe unlocked!","Recette débloquée !"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Algae","Algue"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Can","Canette"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["Press the inventory button to see it","Appuyez sur le bouton d'inventaire pour la voir"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Flower","Fleur"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["The flower couldn't be used","La fleur n'a pas pu être utilisée"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Fruit","Fruit"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["The grenade didn't explode","La grenade n'a pas explosée"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Jellyfish","Méduse"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Battery","Pile"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Octopus","Poulpe"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["The octopus didn't find any nearby resource","Le poulpe n'a pas trouvé de ressources à proximité"]}},{"Category":"Resources","Lines":{"keys":["EN","FR"],"values":["Souvenir","Souvenir"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["Resource picked up","Ressource récupérée"]}},{"Category":"Pause","Lines":{"keys":["EN","FR"],"values":["Resume","Reprendre"]}},{"Category":"Main Menu","Lines":{"keys":["EN","FR"],"values":["Settings","Options"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Is someone there?","Il y a quelqu'un ici ?"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I need to talk to people","Faut que je parle à des gens "]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["It's time for some shopping!","C'est l'heure de faire les courses !"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I have to collect resources to survive in this hostile world.","Je dois ramasser des ressources pour pouvoir survivre dans ce mond hostile."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Find Napoléon in the wreck","Trouver Napoléon dans l'épave"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I have to talk to an old pirate named Napoléon to find out where he hid the skate-bulles. They said they would give me something if I succeed.","J'dois parler à un vieux pirate qui s'appelle Napoléon pour savoir où il a caché les skate-bulles. ils m'ont dit qu'ils allaient me donner un truc si je réussi."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Find the skate-bulles","Trouver les skate-bulles"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Napoléon gave me the map to find the skate-bulles, I have to find them...","Napoléon m'a donné la carte pour trouver les skate-bulles, j'dois les trouver..."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Bring the skate-bulles back to the young people","Ramener les skate-bulles aux jeunes"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I found the skates! I need to bring them back to the young people.","J'ai trouvé les skates ! Faut que je les ramène aux jeunes."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Leave the area","Sortir de la zone"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["They gave me the recipe for the propeller hat, apparently it can help me get out of this area...","Les jeunes m'ont donné la recette du chapeau hélice, apparemment ça peut m'aider à sortir de cette zone..."]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["Bring it back to the young people for a reward","Rapportez le aux jeunes pour une récompense"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["","Skate Bulle récupéré"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Napoléon the pirate","Napoléon le pirate"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["The skate-bulle","Le skate-bulle"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["The map to find the skate-bulles","La carte pour trouver les skate-bulles"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Oop rhymes","Les rimes on oop"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["People who don't like blob fish (like me lol)","Les gens qui aiment pas les blob fish (comme moi lol)"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["He always has a cold, yuck!","Il est toujours enrhumé berk !"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["    : In his organic grenade stand","    : Dans son stand de grenades bio"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["The blob fish","Le blob fish"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Sloop and the Lost Recipe","Sloop et la recette perdue"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I need to find the recipe that Sloop lost in the crater.","Je dois trouver la recette que Sloop a perdu dans le cratère."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Bring back the recipe","Ramener la recette"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I found it!!! Now I have to bring it back to him...","Je l'ai trouvée !!! Maintenant je dois lui ramener..."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I can use it too!","Moi aussi j'peux m'en servir !"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Now that I have the recipe I could make a grenade to explode the rock that blocks this big geyser","Maintenant que j'ai la recette je pourrais fabriquer la grenade pour exploser le rocher qui bloque ce gros geyser"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["IT'S GONNA BE LOUD!!!!","ÇA VA PÉTER !!!!"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I only have to explode the rock with the grenade now!!!!","J'ai plus qu'à faire exploser le rocher avec la grenade !!!!"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["Yuck!!! Don't drink it.","Berk !!! Faut pas la boire."]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["To lower saltiness!","Pour baisser le seum !"]}},{"Category":"Options","Lines":{"keys":["EN","FR"],"values":["Thermometer","Thermomètre"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>Pollution","<br>La pollution"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br><br>Counting","<br><br>Compter"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Overwater diving","La plongée sur-marine"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["",""]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Algae-eating pollution fan","Mangeur d'algues fan de pollution"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["   : Near a pollution zone","   : Près d'une zone de pollution"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["The manatee collector","Le lamentin collectionneur"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["10 000 cans and 10 000 batteries?","10 000 canette et 10 000 piles ?"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I have to take a battery and a can back to Urfe. He said he'd give me something to deal with the pollution if I help him.","J'dois ramener une pile et une canette à Urfe. Il a dit qu'il me donnait un truc contre la pollution si je l'aide."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Only the can left","Plus que la canette "]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I have to find a can.","Je dois encore trouver une canette."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Only the battery left!","Plus que la pile !"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I still have to find a battery.","Je dois encore trouver une pile."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Bring back the items","Ramener les objets"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I need to bring the items back to Urfe","Il faut que je ramène les objets à Urfe."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Urfe the manatee","Urfe le lamentin"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["A battery","Une pile"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["A can","Une canette"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["To see through walls!","Pour voir à travers les murs !"]}}]}