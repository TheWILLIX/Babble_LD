OP2","Objective.SLOOP3","Objective.SLOOP4","Objective.URFE1","Objective.URFE2","Objective.URFE3","Objects.AmpouleFleur","Objects.BriquetMeduse","Objects.BrochetteFruit","Objects.Brouilleur","Objects.Campement","Objects.ChapeauHelice","Objects.ChapeauMeduse","Objects.Fastfood","Objects.Grenade","Objects.LancePile","Objects.MeduseCoussin","Objects.MeduseDisco","Objects.ParfumAloa","Objects.ParfumFruite","Objects.PiegeBanane","Objects.PoulpeCasque","Objects.PoulpeCoussin","Objects.PoulpePropulseur","Objects.Soupe","Objects.Sushi","Objects.VisionPoulpe","OphelieRole","Palmi.Subtitle","ParfumFruite.Description","ParfumNaturel.Description","PiegeFruit.Description","Pile01","Pile02","Play","Poulpe01","Poulpe02","PoulpeCasque.Description","PoulpeCoussin.Description","PoulpePropulseur.Description","Quit","ReceiveItemDescription","ReceiveItemSubtitle","Recipe.Title","Resource.Algue","Resource.Canette","Resource.Description","Resource.Fleur","Resource.Fleur.Description","Resource.Fruit","Resource.Grenade.Description","Resource.Méduse","Resource.Pile","Resource.Poulpe","Resource.Poulpe.Description","Resource.Souvenirs","Resource.Subtitle","Resume","Settings","Skate0.01","Skate0.02","Skate0.03","Skate0.04","Skate1.01","Skate1.02","Skate2.01","Skate2.02","Skate3.01","Skate3.02","Skate4.01","Skate4.02","SkateBulleGet.Description","SkateBulleGet.Subtitle","SkateImage1.01","SkateImage1.02","SkateImage2.01","Sloop.Aime","Sloop.AimePas","Sloop.Description","Sloop.Lieu","Sloop.Soustitre","Sloop1.01","Sloop1.02","Sloop2.01","Sloop2.02","Sloop3.01","Sloop3.02","Sloop4.01","Sloop4.02","SoupeEncre.Description","Sushi.Description","ThermometerVisibility","Urfe.Aime01","Urfe.Aime02","Urfe.Aime03","Urfe.AimePas","Urfe.Description","Urfe.Lieu","Urfe.Soustitre","URFE1.01","URFE1.02","URFE2.01","URFE2.02","URFE3.01","URFE3.02","URFE4.01","URFE4.02","URFEIMAGE1.01","URFEIMAGE1.02","URFEIMAGE1.03","VisionPoulpe.Description"],"values":[{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["Mini resource to use against pollution.","Mini ressource contre la pollution."]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["I saw the same ones in dad's garden.","Il y avait les mêmes dans le jardin de papa."]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["Big light","Grande lumière"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["Medium light","Moyenne lumière"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["To become less salty!","Pour remonter le seum !"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["To open an electric door!","Pour ouvrir une porte éléctrique !"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["To be ultra fresh in the morning.","Pour être ultra frais au réveil."]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["Pollution item...yuck","Objet de pollution...beurk"]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["I tried to drink it, I saw flying fishes","J'ai essayé d'en boire, j'ai vu des poissons volants."]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["Press the notebook button to see it","Appuyez sur le bouton de carnet pour le voir"]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["Press the notebook button for more details","Appuyez sur le bouton du carnet pour plus de détails"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["To go against the flow with swag","Pour aller à contre courant avec swag"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["Medium light","Moyenne lumière"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["The beginning of a great story...","Le début d'une grande histoire..."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Once upon a time there was a whale.","Il était une fois une baleine."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["The continuation of a great story","L'avancée d'une grand histoire"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["One day, it died.","Un jour, elle mourut."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["The end of a great story","La fin d'une grande histoire"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Then it became a skeleton.","Puis elle devint un squelette."]}},{"Category":"Notification","Lines":{"keys":["EN","FR"],"values":["collected","récupéré"]}},{"Category":"Main Menu","Lines":{"keys":["EN","FR"],"values":["Credits","Crédits"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["The skate-bulle","Le skate-bulle "]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>Rap<br><br>","<br>Le rap<br><br>"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br><br>FIGHT (mainly Gumpy actually)<br><br>","<br><br>LA BAGARRE (surtout Gumpy en fait)<br><br>"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Napoléon (normal)","Napoléon (normal)"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>Losers","<br>Les boloss"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Ablette, Gumpy, and Dumbo, the cool three!","Ablette, Gumpy et Dumbo, les plus stylés !"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Propeller hat","Chapeau hélice"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>Sushi","<br>Sushi"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["      : In front of the skate park","      : Devant le skate parc"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["The young gang","Le gang de jeunes"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["A sand hockey match","Un match de hockey sur sable"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["In the year 2004 before Poseidon, Marline was enjoying her youth. She was traveling all around the sea, looking for new experiences.<br><br>But today, her goal was different: to watch the sand hockey finals. Her favorite team, the Tokyeau Sharks, were up against their eternal rivals, the Saint-Marin Otters. In no case did she want to miss this show. So, dressed with her best fan gear, she entered the first bar she saw on her path.","An 2004 avant Poséidon, Marline jouissait de sa jeunesse, elle voyageait partout dans l'océan à la recherche de nouvelles expériences.<br><br>Mais aujourd'hui son objectif était tout autre : regarder la finale du match de hockey sur sable. Son équipe favorite les Tokyeau Sharks contre leurs rivaux éternels les Saint-Marin Otters. Elle ne voulait en aucun cas rater ce spectacle. Alors, vêtue de son plus bel attirail de supporter, elle entra dans le premier bar qui croisa sa route.  "]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["The piracy degree","Le diplôme de piraterie"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["- I'll give you one thing, this boat isn't a baby turtle without arms...<br>- It was a gift from my parents when I graduated from pirate school...<br>- Wow. What are we waiting for to get in? The Tokyeau Sharks are waiting for us!<br><br>They entered and made their way to the cockpit. Napoléon successfully led his boat-pooler to his match.<br><br>- Thanks my little pirate. Come to the game with me, I'll buy you a drink.","- Pour le coup, c’est pas un bateau de bébé tortue sans bras…<br>- C’est un cadeau d’mes parents qui date de l’obtention de mon diplôme de piraterie…<br>- Waouw. On attend quoi pour monter dedans ? Les Tokyeau Sharks nous attendent !<br><br>Ils entrèrent et se dirigèrent vers la cabine de pilotage. Napoléon conduisit avec succès sa co-batureuse jusqu’à son match.<br><br>- Merci mon p’tit pirate. Viens au match avec moi, j’te paye une boisson."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Marline the leader","Marline la leadeuse"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Too impressed to refuse, the pirate followed the woman to the stadium.<br>Of course the fabulous Tokyeau Sharks won, Marline was crazy with joy and drank a few too many cocktails. She couldn't even stand straight enough to leave the stadium. Napoléon helped her by taking her under his tentacles.<br><br>- You know, your tentacles are not so bad after all. I like them.","Trop impressionné pour refuser, le pirate suivit la femme jusqu’au stade.<br>Bien-sûr les fabuleux Tokyeau Sharks gagnèrent, Marline folle de joie bu un peu trop de cocktails. Elle ne tenait même plus debout pour sortir du stade. Napoléon l’aida en la prenant sous ses tentacules.<br><br>- T’sais qu’elles sont pas si mal tes tentacules finalement. Elles me plaisent bien."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Good night pirates","Bonne nuit les pirates"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Embarrassed by this unexpected statement, Napoléon suddenly let go of the one he was helping to walk. Dying of laughter, she rolled on the floor and exclaimed:<br><br>- You may not be a good pirate Napolele, but you're a crazy enough octopus to stay with me. I like you, can I sleep in your boat tonight? I don't know where to go.<br><br>Napoléon accepted without hesitation to welcome Marline in his boat. This woman, although original, had just declared her love for him. Perhaps tomorrow all this will no longer be, but tonight, he was living one of the best moments of his life.","Gêné par cette phrase inattendue, Napoléon lâcha d’un seul coup celle qu’il aidait à marcher. Morte de rire, elle se roula par terre et s’exclama :<br><br>- T’es ptetre pas un bon pirate Napolélé, mais t’es un poulpe assez fou pour rester avec moi. J't'aime bien, j’peux dormir dans ton bateau cette nuit ? J’sais pas où aller.<br><br>Napoléon accepta sans hésiter d'accueillir Marline, cette femme, bien qu’originale venait de lui déclarer son amour. Peut-être que demain tout ça n’existera plus, mais ce soir, il vivait l’un des meilleurs moments de sa vie."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["The quietest bar on the sea","Le bar le plus calme de l'océan"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Proud and restless, she ordered a cocktail and sat in front of the television. But very soon noticed that the warm and feisty atmosphere so common to sand hockey matches was not there.<br>She found that only two customers were sitting in front of the television with her.<br>One was sleeping with a beer in his hand and the other was watching the program that was playing, some kind of general knowledge show called \"Fish Tank\". He was answering to the questions of the famous present Julien Leperche with such vigor that Marine couldn't help but being carried away by the spectacle.","Fière et impatiente, elle commanda un cocktail et s'installa devant la télévision. Mais elle se rendit très vite compte que l'ambiance chaleureuse des matchs de hockey sur sable n'était pas au rendez-vous.<br>Elle constata que seuls deux clients étaient assis devant la télévision avec elle.<br>L'un dormait sa bière à la main et l'autre regardait le programme qui passait, une sorte d'émission de culture générale appelée “Question pour un poisson”. Il répondait aux questions du célèbre présentateur Julien Laperche avec une telle vigueur que Marline se laissa emporter par ce spectacle."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Fish Tank","Question pour un poisson"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["This big octopus who looked like a pirate seemed fascinated by a program clearly aimed at people of the 5th age!<br>But suddenly, the feeling of the supporter hat on her head reminded her of the purpose of her visit.<br><br>- Oh, you old octopus, will you change the channel?<br>- In your dreams my good lady.<br><br>Marline's ears twitched. Not only did he deny her request but he also disrespected her. She climbed the table and changed the channel under the offended look of the octopus.","Ce gros poulpe qui semblait être un pirate était fasciné par une émission pour le 5ème âge !<br>Mais soudain, elle sentit son chapeau de supporter sur sa tête et se rappela du but de sa venue.<br><br>- Oh, vieux poulpe, tu veux bien changer de chaîne ?<br>- Dans tes rêves ma bonne dame.<br><br>Les oreilles de Marline frémirent. Non seulement il avait refusé sa proposition mais en plus, il lui avait manqué de respect. Elle monta sur la table et changea de chaîne sous le regard offusqué du poulpe."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Wet behind the ears","Marline la poule d'eau"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["- Who do you think your are? You're still wet behind the ears!<br>- I think I am a Tokyeau Sharks fan, old man!<br>She lifted her hat and placed it on the octopus' red skull.<br>- Watch it with with me, you'll see it's better than your nonsense.<br>Mad with rage and humiliated, the octopus grabbed the cocktail of the one who was bothering him to throw it at her.<br>- Get off my table!!<br>Marline avoided the projectile with such an ease that she could easily be mistaken for the main actress of an adventure film. She was, after all, used to it.","- Tu t'prends pour qui ma poule d’eau ?<br>- Pour une fan des Tokyeau Sharks mon vieux !<br>Elle brandit son chapeau et le posa sur le crâne rouge du poulpe.<br>- Regarde avec moi, tu vas voir c'est mieux que tes âneries.<br>Fou de rage et humilié, le poulpe attrapa le cocktail de celle qui le dérangeait pour lui lancer dessus.<br>- Barre toi d'ma table !!<br>Marline évita le projectile avec une facilité digne de l’actrice principale d’un film d’aventure, il faut dire qu'elle avait l'habitude."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Large tentacles","Grosses tentacules"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["You think you scare me with your big tentacles?<br>The supporter approached him and ran her finger over the many suction cups on the pirate's tentacle.<br><br>- Don't touch me!!<br><br>OH! What's going on here?<br><br>The bartender, taken aback by the argument of the two customers, walked towards them.","Tu crois que tu m'fais peur avec tes grosses tentacules ?<br>La supporter s'approcha de lui et passa ses doigts sur les nombreuses ventouses présentes sur les tentacules du pirate.<br><br>- M'touche pas !!<br><br>- OH ! Qu’est-ce qu’il se passe ici ?<br><br>Le barman, interloqué par la dispute des deux clients se dirigea vers eux."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Ocean Indiana Jones","Ocean Indiana Jones"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["I only wanted to watch the sand field hockey game and this freshwater pirate is stopping me!<br>- You'll see if I'm a freshwater pirate!<br>The octopus launched itself on Marline and tackled her to the ground. This would be it, would the very one he tackled  not practice multiple combat sports. She retaliated as quickly.<br>- GET OUT OF HERE! Go fight outside you savages!<br>The owner of the establishment kicked out the two fighters and they both found themselves at the door.<br>- You happy? None of us can watch the TV, now.","Je voulais seulement regarder le match de hockey sur sable et ce pirate d’eau douce m’en empêche !<br>- Tu vas voir si j’suis un pirate d’eau douce.<br>Le poulpe se lança sur Marline et la plaqua au sol, seulement, celle-ci pratiquait plus d’un sport de combat, elle riposta aussi vite.<br>- SORTEZ D’ICI ! Allez vous battre dehors bande de sauvages !<br>Le patron de l'établissement sortit les deux combattants à coup de pied et ils se retrouvèrent tous les deux à la porte.<br>- T’es contente ? Aucun d’nous peut r’garder la télé maint’nant."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["In the end a rugby match?","Finalement un match de rugby ?"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["- Are you really a pirate? You fight like a baby turtle with no arms.<br>- Consarn! You'll see if I'm not a pirate!<br>- Show me your boat then! If you take me to the ice hockey stadium before the game is over, I give you my respect.<br>Marline always knew how to turn situations in her favor, with this proposal she was almost sure to be able to attend her match.<br>- Follow me, I've got the most beautiful boat in the ocean.<br>On the way, the adventurer tried to find out more about her new driver.","- T’es vraiment un pirate toi ? Tu te bats comme un bébé tortue sans bras.<br>- Vindiou ! Tu vas voir si j’suis un pirate !<br>- Montre moi ton bateau alors ! Si tu m'emmènes au stade de hockey sur glace avant la fin du match, je te donne mon respect.<br>Marline savait toujours tourner les situations en sa faveur, avec cette proposition elle était pratiquement sûre de pouvoir assister à son match.<br>- Suis-moi, j’ai l’plus beau rafiot d’l’océan.<br>Sur le chemin, l’aventurière chercha à en savoir plus sur son désormais conducteur."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Who are you anyway?","T'es qui toi au fait ?"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["- So what's your name?<br>- Napoléon.<br>- Ahaha, finally a quality. It's a beautiful name.<br>- Hm.<br>The pirate was not very talkative, it must be said that he felt overwhelmed by the invasive charisma of this fish like no other. Said person now walked proudly while humming a joyful tune. She had beaten him by far during their altercation and now she wanted to get into his boat. She had managed to manipulate him without him even suspecting it. This woman was really impressive.","- Tu t’appelles comment toi ?<br>- Napoléon.<br>- Ahaha, enfin une qualité. C’est un beau prénom.<br>- Hum.<br>Le pirate n’était pas très bavard, il faut dire qu’il se sentait écrasé face au charisme envahissant de ce poisson pas comme les autres. Celle-ci marchait fièrement en chantonnant un air joyeux, elle l’avait largement battu lors de leur altercation et maintenant elle voulait monter dans son bateau. Elle avait réussi à le manipuler sans même qu’il s’en doute. Cette femme était vraiment impressionnante."]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["Marline the adventurer","Marline l'aventurière"]}},{"Category":"Collectible","Lines":{"keys":["EN","FR"],"values":["- I am Marline, adventurer from father to daughter! I have already crossed the ocean three times! And you, do you walk around a lot?<br>- No...I'm in a pirate group, but they never call me to go on missions.<br>- Ahaha, you must be really bad. It's pathetic.<br>- I prefer pottery to piracy...<br><br>An interesting information seemed to come out of this octopus at last, but before the adventurer could say anything, they reached the ship. In front of them was a large, brand new frigate.","- Moi je suis Marline, aventurière de père en fille ! J’ai déjà traversé l’océan trois fois ! Et toi, tu te balade beaucoup ?<br>- Non…j’suis dans un groupe de pirates, mais ils m’appellent jamais pour partir en mission.<br>- Ahaha, tu dois être vraiment mauvais. C’est lamentable.<br>- J’prefère la poterie à la piraterie…<br><br>Une partie intéressante semblait enfin se dégager de ce poulpe, mais avant que l’aventurière ne puisse répondre quoi que ce soit, ils atteignirent le bateau. Devant eux, se présentait une grande frégate flambant neuve. "]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["A bad burger...","Un burger pas bon..."]}},{"Category":"Pause","Lines":{"keys":["EN","FR"],"values":["Feedback","Feedback"]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["To burn algae walls!","Pour brûler des murs d'algues !"]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["There's no point in trying to burn Napoléon's boat with that...","Ça sert à rien d'essayer de brûler le bateau de Napoléon avec..."]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["Sugar beats salt? Maybe...","Ça remonte un peu le seum !"]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["Is this a bananaception?","Est-ce que c'est une bananeception ?"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Place","Lieu"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["TO MAKE EVERYTHING EXPLODE!!","POUR TOUT FAIRE PETER !!"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Pillow jellyfishes","Les méduses coussins "]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>Pillow jellyfishes","<br>Les méduses coussins  "]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br><br>Pillow jellyfishes","<br><br>Les méduses coussins  "]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["People who hurt pillow jellyfishes","Les gens qui font du mal aux méduses coussins"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["A talking rock.","Une pierre qui parle."]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["    : Alone with his pillow jellyfishes","    : Seul avec ses méduses coussins"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["My rock buddy","Mon pote caillou"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["The jellyfish challenge","Le défi des méduses"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Hotu challenged me to pass his pillow jellyfish course! If I pass, he'll give me something.","Hotu m'a mis au défi de réussir son parcours de méduses coussins ! Si je réussis, il va me donner un truc."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["The Water Olympics games course","Le parcours des jeux Eaulympiques "]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["I'm so good! Hotu prepared me another course.","J'suis trop fort ! Hotu m'a préparé un autre parcours. "]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["The final course","The final parcours"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Hotu is shocked by my success. He has created a course that he says is impossible to pass...","Hotu est trop choqué que je réussise tous ses défis. Il a crée un parcours impossible à réussir d'après lui..."]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["Hotu the rock","Hotu le caillou"]}},{"Category":"Objectives","Lines":{"keys":["EN","FR"],"values":["The jellyfish course","Le parcours de méduses"]}},{"Category":"Options","Lines":{"keys":["EN","FR"],"values":["Invert the Y Axis","Inverser l'axe Y"]}},{"Category":"Options","Lines":{"keys":["EN","FR"],"values":["Jump mode","Mode de saut"]}},{"Category":"Options","Lines":{"keys":["EN","FR"],"values":["Keyboard-Mouse Mode","Mode Clavier-Souris"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["Craft failed successfully!","Craft fail !!"]}},{"Category":"Options","Lines":{"keys":["EN","FR"],"values":["Language","Langue"]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["Did you know? Hotu doesn't have arms because he's a rock!","Le saviez-vous ? Hotu n'a pas de bras car c'est un caillou !"]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["DEASH SQUAD IN CONSERT JUNE 25 AT WALE CEMETERY!!! COME IN NUMBER!!!!","L'ECHECOUADE DE LA MORT EN CONCER LE 25 JUIN AU CIMETIERE DÉ BALEINE !!! VENEZ NOMBREU !!!!! "]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["Disappearance Alert: A child with a starfish on his head, wearing a yellow banana, red shorts and a pink t-shirt.","Alerte Disparition : Un enfant avec une étoile de mer sur la tête, il porte une banane jaune, un short rouge et un t-shirt rose. "]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["Weather foresea : It is currently 24°C, a school of whales will darken the sky at 3 pm. Tomorrow will be sunny all day!","Météocéan : Il fait actuellement 24°, un banc de baleines va obscurcir le ciel à 15h. Demain un grand soleil toute la journée ! "]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["The Witcher books were inspired by Ablette in Babbles to name Geralt's mount. ","Les livres \"The Witcher\" se sont inspirés d'Ablette dans Babbles pour nommer la monture de Geralt. "]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["A special pillow jellyfish is hiding in the forest, can you find it?","Une méduse coussin spéciale se cache dans la forêt, saurez-vous la trouver ?"]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["Offers jellyfish cushion jumping courses, call 024578956584512365887469852164 ","Propose cours de sauts sur méduses coussins, appelez le 024578956584512365887469852164 "]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["Astere here, don't forget to leave a good comment on our game plz!","Ici Astère, n'oubliez pas de laissez un bon commentaire sur notre jeu svp !! "]}},{"Category":"LoadingTip","Lines":{"keys":["EN","FR"],"values":["Sale of organic grenades 100% explosive! -50% off with the promo code: BLOBFISHESAREBEAUTIFUL","Vente de grenades bio 100% explosives ! -50% avec le code promo : LESBLOBFISHLESPLUSBEAUX "]}},{"Category":"Pause","Lines":{"keys":["EN","FR"],"values":["Main Menu","Menu Principal"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Adventure","L'aventure"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>Kelp forests","<br>Les forêts de varech"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br><br>Clubbing (hard)","<br><br>Les sorties en boîte (de sardines)"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Dad wet behind the ears (she's right)","Papa la poule sèche (elle a raison)"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br><br><br>Having friends","<br><br><br>Avoir des amis"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Best grandma in the world <3","La meilleure mamie du monde <3"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Grenade","Grenade"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>Camp","<br>Campement"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":[": Deep in the whale graveyard",": Au fond du cimetière des baleines"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["The adventurer","L'aventurière"]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["It lights the path.","Elle éclaire le chemin."]}},{"Category":"ResourceCard","Lines":{"keys":["EN","FR"],"values":["I hope it's not too tight in here...","J'espère qu'elle est pas trop serrée là dedans..."]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["To bounce around everywhere!","Pour rebondir partout !"]}},{"Category":"Recipes","Lines":{"keys":["EN","FR"],"values":["It's just to be swag","Ça sert juste à être swag"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Pottery","Les poteries"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br>A certain Liline","<br>Une certaine Liline"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["<br><br>Fish Tank","<br><br>Question pour un poisson"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["Young people (he's a boomer)","Les jeunes (c'est un boomer)"]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["An old stinking octopus.","Un vieux poulpe qui pue."]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["    : In a wreck as modly as he is.","    : Dans un épave moisie comme lui."]}},{"Category":"Contacts","Lines":{"keys":["EN","FR"],"values":["The old pirate","Le vieux pirate"]}},{"Category":"NotebookIntro","Lines":{"keys":["EN","FR"],"values":["For all my super adventures!","Pour toutes mes super aventures !"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Explore the forest and talk to the inhabitants","Explorer la forêt et parler aux habitants"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Find and talk to the young people","Trouver et parler aux jeunes"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Explore the forest and talk to the inhabitants","Explorer la forêt et parler aux habitants"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Find Napoléon in the wreck","Trouver Napoléon dans l'épave "]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Using the map, find the skate-bulles in Napoléon's hiding place","Trouver les skate-bulles dans la cachette de Napoléon grâce à sa carte"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Bring the skate-bulles back to the young people","Ramener les skate-bulles aux jeunes"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Get out of the area using the Propeller Hat","Sortir de la zone grâce au Chapeau Hélice"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Find the recipe Sloop lost in the crater","Trouver la recette que Sloop a perdu dans le cratère "]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Bring the Grenade recipe back to Sloop","Ramener la recette de la Grenade a Sloop"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Craft a Grenade to unblock the large geyser","Fabriquer une Grenade pour débloquer le gros geyser"]}},{"Category":"ObjectiveData","Lines":{"keys":["EN","FR"],"values":["Use the Grenade to explode the rock on the large geyser","Utiliser la Grenade pour exploser le rocher sur le gros geyser"]}},{"Category":"ObjectiveData","Lines":