      objectReference: {fileID: 0}
    - target: {fileID: 2599644322761406751, guid: 736d416f31529b349a018fd9abd16ee4, type: 3}
      propertyPath: Lines.values.Array.data[187].Lines.values.Array.data[0]
      value: "I have to talk to an old pirate named Napol\xE9on to find out where
        he hid the skate-bulles. They said they would give me something if I succeed."
      objectReference: {fileID: 0}
    - target: {fileID: 2599644322761406751, guid: 736d416f31529b349a018fd9abd16ee4, type: 3}
      propertyPath: Lines.values.Array.data[187].Lines.values.Array.data[1]
      value: "J'dois parler \xE0 un vieux pirate qui s'appelle Napol\xE9on pour savoir
        o\xF9 il a cach\xE9 les skate-bulles. ils m'ont dit qu'ils allaient me donner
        un truc si je r\xE9ussi."
      objectReference: {fileID: 0}
    - target: {fileID: 2599644322761406751, guid: 736d416f31529b349a018fd9abd16ee4, type: 3}
      propertyPath: Lines.values.Array.data[188].Lines.values.Array.data[0]
