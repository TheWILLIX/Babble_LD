      propertyPath: Lines.values.Array.data[189].Lines.values.Array.data[0]
      value: "Napol\xE9on gave me the map to find the skate-bulles, I have to find
        them..."
      objectReference: {fileID: 0}
    - target: {fileID: 2599644322761406751, guid: 736d416f31529b349a018fd9abd16ee4, type: 3}
      propertyPath: Lines.values.Array.data[189].Lines.values.Array.data[1]
      value: "Napol\xE9on m'a donn\xE9 la carte pour trouver les skate-bulles, j'dois
