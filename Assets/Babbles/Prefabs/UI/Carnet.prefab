        - EN
        - FR
        values:
        - <br>Rap<br><br>
        - <br>Le rap<br><br>
    - Category: Contacts
      Lines:
        keys:
        - EN
        - FR
        values:
        - <br><br>FIGHT (mainly Gumpy actually)<br><br>
        - <br><br>LA BAGARRE (surtout Gumpy en fait)<br><br>
    - Category: Contacts
      Lines:
        keys:
        - EN
        - FR
        values:
        - Napoleon (normal)
        - "Napol\xE9on (normal)"
    - Category: Contacts
      Lines:
