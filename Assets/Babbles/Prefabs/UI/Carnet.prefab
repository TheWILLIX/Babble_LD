  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8f6e2cfd1971e94b81c4d2a48f08cfd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Lines:
    keys:
    - Algue01
    - Algue02
    - Canette01
    - Canette02
    - Credits
    - Fleur01
    - Fleur02
    - Fruit01
    - Fruit02
    - InvertYAxis
    - JumpInput
    - KeyboardMouseMode
    - Language
    - MainMenu
    - Meduse01
    - Meduse02
    - OphelieRole
    - Play
    - Quit
    - Resume
    - Settings
    - ThermometerVisibility
    values:
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - Mini resource to use against pollution.
        - Mini ressource contre la pollution.
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - I saw the same ones in dad's garden.
        - "Il y avait les m\xEAmes dans le jardin de papa."
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - Pollution item...yuck
        - Objet de pollution...beurk
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - I tried to drink it, I saw flying fishes
        - "J'ai essay\xE9 d'en boire, j'ai vu des poissons volants."
    - Category: Main Menu
      Lines:
        keys:
        - EN
        - FR
        values:
        - Credits
        - "Cr\xE9dits"
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - To burn algae walls!
        - "Pour br\xFBler des murs d'algues !"
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - There's no point in trying to burn Napoleon's boat with that...
        - "\xC7a sert \xE0 rien d'essayer de br\xFBler le bateau de Napol\xE9on avec..."
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - Sugar beats salt? Maybe...
        - "\xC7a remonte un peu le seum !"
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - Is this a bananaception?
        - Est-ce que c'est une bananeception ?
    - Category: Options
      Lines:
        keys:
        - EN
        - FR
        values:
        - Invert the Y Axis
        - Inverser l'axe Y
    - Category: Options
      Lines:
        keys:
        - EN
        - FR
        values:
        - Jump mode
        - Mode de saut
    - Category: Options
      Lines:
        keys:
        - EN
        - FR
        values:
        - Keyboard-Mouse Mode
        - Mode Clavier-Souris
    - Category: Options
      Lines:
        keys:
        - EN
        - FR
        values:
        - Language
        - Langue
    - Category: Pause
      Lines:
        keys:
        - EN
        - FR
        values:
        - Main Menu
        - Menu Principal
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - It lights the path.
        - "Elle \xE9claire le chemin."
    - Category: ResourceCard
      Lines:
        keys:
        - EN
        - FR
        values:
        - I hope it's not too tight in here...
        - "J'esp\xE8re qu'elle est pas trop serr\xE9e l\xE0 dedans..."
    - Category: Credits
      Lines:
        keys:
        - EN
        - FR
        values:
        - Art Director, Concept & Texture Artist
        - Directrice Artistique, Concept & Texture Artist
    - Category: Main Menu
      Lines:
        keys:
        - EN
        - FR
        values:
        - Play
        - Jouer
    - Category: Main Menu
      Lines:
        keys:
        - EN
        - FR
        values:
        - Quit
        - Quitter
    - Category: Pause
      Lines:
        keys:
        - EN
        - FR
        values:
        - Resume
        - Reprendre
    - Category: Main Menu
      Lines:
        keys:
        - EN
        - FR
        values:
        - Settings
        - Options
    - Category: Options
      Lines:
        keys:
        - EN
        - FR
        values:
        - Thermometer
        - "Thermom\xE8tre"
  line: Meduse02
  lineID: 15
