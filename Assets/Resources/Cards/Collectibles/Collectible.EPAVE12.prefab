  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "G\xEAn\xE9 par cette phrase inattendue, Napol\xE9on l\xE2cha d\u2019un
    seul coup celle qu\u2019il aidait \xE0 marcher. Morte de rire, elle se roula
    par terre et s\u2019exclama :\r\n \r\n- T\u2019es ptetre pas un bon pirate Napol\xE9l\xE9,
    mais t\u2019es un poulpe assez fou pour rester avec moi. J't'aime bien, j\u2019peux
    dormir dans ton bateau cette nuit ? J\u2019sais pas o\xF9 aller.\r\n\r\nNapol\xE9on
    accepta sans h\xE9siter d'accueillir Marline, cette femme, bien qu\u2019originale
    venait de lui d\xE9clarer son amour. Peut-\xEAtre que demain tout \xE7a n\u2019existera
    plus, mais ce soir, il vivait l\u2019un des meilleurs moments de sa vie. \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e51d75028f0b5bc45a663410f3b1257d, type: 2}
  m_sharedMaterial: {fileID: 559331918830543118, guid: e51d75028f0b5bc45a663410f3b1257d, type: 2}
